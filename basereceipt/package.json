{
  "name": "basereceipt",
  "version": "0.1.0",
  "description": "Non-custodial USDC payment-verification SDK for Base (mainnet + Sepolia). Verify payments on-chain without holding funds.",
  "keywords": [
    "base",
    "usdc",
    "payments",
    "verification",
    "x402",
    "web3",
    "ethereum",
    "non-custodial",
    "coinbase"
  ],
  "author": "BaseReceipt Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/technea/BaseReceipt.git"
  },
  "homepage": "https://github.com/technea/BaseReceipt#readme",
  "bugs": {
    "url": "https://github.com/technea/BaseReceipt/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
